{
  "id": "kaohandt-marginal",
  "name": "Kaobook Marginal",
  "description": "Guía autoinstruccional con columna principal y margen pedagógico para conceptos, recuperación, evidencias y referencias complementarias.",
  "documentClass": "kaohandt",
  "version": "0.9.8+jintia.1",
  "upstream": {
    "repository": "https://github.com/fmarotta/kaobook",
    "commit": "22225a174f1b667a50c0a80afb48c498e8126dc1",
    "license": "LPPL-1.3-or-later"
  },
  "tags": ["Kaobook", "Marginal", "Académico", "Autoinstruccional"],
  "previewType": "kaohandt-marginal",
  "featured": false,
  "capabilities": {
    "marginNotes": true,
    "marginFigures": true,
    "wideLayout": true,
    "coloredBlocks": true,
    "biblatex": true,
    "tikz": true,
    "visualPlacements": ["auto", "main", "wide", "margin"]
  },
  "blocks": {
    "softblock": { "title": "Orientación", "color": "#f7f8fa" },
    "accentblock": { "title": "Análisis", "color": "primary" },
    "mintblock": { "title": "Práctica", "color": "#e8f7f0" },
    "sandblock": { "title": "Advertencia", "color": "#fdf5e6" },
    "roseblock": { "title": "Error crítico", "color": "#fdf0f0" }
  },
  "pageOptions": {
    "lang": "es",
    "citestyle": "apa",
    "bibstyle": "apa",
    "fontSize": "10pt",
    "side": "oneside",
    "layout": "margin"
  },
  "requiredFiles": [
    "kaohandt.cls",
    "kao.sty",
    "kaobiblio.sty",
    "kaorefs.sty",
    "kaotheorems.sty",
    "LICENSE",
    "MANIFEST.md"
  ],
  "validation": {
    "portableFloatContract": true,
    "requiredIntroductionCommands": [
      "\\guidesection",
      "\\editorialtitle",
      "\\conceptline",
      "\\coursemeta"
    ],
    "requiredIntroductionEnvironments": ["softblock"],
    "marginCommands": [
      "\\marginconcept",
      "\\marginquestion",
      "\\marginevidence"
    ]
  }
}
