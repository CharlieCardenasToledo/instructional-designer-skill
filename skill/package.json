{
  "name": "jintia-skill",
  "version": "11.0.0",
  "description": "Jintia Skill for evidence-based self-paced instructional design — HTML editorial engine with Vivliostyle PDF support",
  "license": "MIT",
  "bin": {
    "jintia": "bin/jintia.js"
  },
  "author": "Charlie Cárdenas Toledo <charlie.act7@gmail.com>",
