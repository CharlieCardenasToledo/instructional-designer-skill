  "repository": {
    "type": "git",
    "url": "https://github.com/CharlieCardenasToledo/instructional-designer-skill.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "lint":               "node scripts/content-linter.js",
    "validate":           "node scripts/content-linter.js",
    "render":             "node scripts/guide-renderer.js",
    "compile":            "node scripts/vivliostyle-adapter.js",
    "preview":            "node scripts/vivliostyle-adapter.js preview",
    "preflight":          "node scripts/pdf-preflight.js",
    "html:lint":          "node scripts/html-linter.js",
    "visual:render":      "node scripts/visual-renderer.js",
    "visual:lint":        "node scripts/visual-linter.js",
    "visual:inspect":     "node scripts/visual-inspector.js",
    "visual:regression":  "node scripts/visual-regression.js",
    "visual:progressive": "node scripts/visual-progressive.js",
    "visual:pipeline":    "node scripts/visual-pipeline.js",
    "visual:capabilities":"node scripts/visual-capabilities.js",
    "test":               "node scripts/test-runner.js",
    "archive":            "node scripts/legacy-manager.js",
    "jintia":             "node bin/jintia.js",
    "doctor":             "node bin/jintia.js doctor",
    "behavior:check":     "node scripts/behavior-runner.js",
    "behavior:eval":      "node scripts/behavior-eval.js",
    "brand:check":        "node scripts/brand-validator.js",
    "syllabus:validate":  "node bin/jintia.js syllabus validate",
