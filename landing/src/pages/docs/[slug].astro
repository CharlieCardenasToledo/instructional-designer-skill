---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getDocMeta, DOC_META } from "../../lib/docs-meta";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries
    .filter((entry) => getDocMeta(entry.id) !== undefined)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const meta = getDocMeta(entry.id)!;
const { Content } = await render(entry);

const all = DOC_META.filter((d) => d.section === meta.section);
const idx = all.findIndex((d) => d.slug === meta.slug);
const prev = idx > 0 ? all[idx - 1] : undefined;
const next = idx < all.length - 1 ? all[idx + 1] : undefined;
---

<DocsLayout current={meta}>
  <Content />

  {(prev || next) && (
    <nav class="flex justify-between mt-16 pt-8 border-t border-slate-200 text-sm">
      <div>
        {prev && (
          <a href={`/docs/${prev.slug}`} class="text-slate-500 hover:text-teal-700 transition-colors">
            <span class="block text-xs text-slate-400 mb-1">Anterior</span>
            {prev.title}
          </a>
        )}
      </div>
      <div class="text-right">
        {next && (
          <a href={`/docs/${next.slug}`} class="text-slate-500 hover:text-teal-700 transition-colors">
            <span class="block text-xs text-slate-400 mb-1">Siguiente</span>
            {next.title}
          </a>
        )}
      </div>
    </nav>
  )}
</DocsLayout>
